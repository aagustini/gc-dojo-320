// d06a — for (inicio; condicao; passo) cmd     (estilo C)
// inicio e passo são EXPRESSÕES (ex.: atribuições)
int i;
int soma;

void main() {
    for (i = 0; i < 5; i = i + 1)
        write("i = ", i);               // 0..4

    for (i = 3; i > 0; i = i - 1)
        write("desce ", i);             // 3, 2, 1

    soma = 0;
    for (i = 1; i <= 100; i = i + 1) soma = soma + i;
    write("soma 1..100 = ", soma);      // 5050

    for (i = 10; i < 5; i = i + 1) write("nunca");
    write("fim: i = ", i);              // 10
}
