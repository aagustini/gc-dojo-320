// d05a — break: sai do laço MAIS INTERNO
int i;
int j;

void main() {
    i = 0;
    while (true) {
        i = i + 1;
        if (i == 4) break;
        write("i = ", i);               // 1, 2, 3
    }
    write("saiu com i = ", i);          // 4

    // break em do-while
    i = 10;
    do {
        if (i < 8) break;
        write("do: ", i);               // 10, 9, 8
        i = i - 1;
    } while (i > 0);

    // laços aninhados: o break interno não encerra o externo
    i = 1;
    while (i <= 3) {
        j = 1;
        while (true) {
            if (j > i) break;
            j = j + 1;
        }
        write("j = ", j);               // 2, 3, 4
        i = i + 1;
    }
}
