// d03b — incrementos dentro de expressões e como comandos
// (avaliação da esquerda para a direita, como na máquina de pilha)
int a;
int b;
int c;
int i;

void main() {
    a = 1;
    b = a++ + a++;                      // 1 + 2
    write("b = ", b);                   // 3
    write("a = ", a);                   // 3

    c = ++a * 2;                        // a = 4; c = 8
    write("c = ", c);                   // 8

    i = 0;
    while (i < 3) {
        write("i = ", i);               // 0, 1, 2
        i++;                            // incremento como comando
    }
    while (i-- > 0) write("desce ", i); // 2, 1, 0
    write("i = ", i);                   // -1
}
